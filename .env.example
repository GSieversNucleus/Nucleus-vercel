# Copy these into your Vercel project's Settings → Environment Variables
# (not a real .env file you commit — Vercel deployments read env vars from
# the dashboard, or from `vercel env` if you use the CLI).

NUCLEUS_ADMIN_EMAIL=you@cserectors.com
NUCLEUS_ADMIN_PASSWORD=change-this-to-a-real-password

NUCLEUS_ENCRYPTION_KEY=

# --- Data storage: no setup needed here ------------------------------------
# Nucleus on Vercel stores its data in Upstash Redis instead of a local file
# (Vercel's serverless functions don't have persistent disk). Once you add
# the "Upstash Redis" integration to this project from the Vercel Marketplace
# and connect it, Vercel automatically injects:
#
#   KV_REST_API_URL=...
#   KV_REST_API_TOKEN=...
#
# Do not set these two yourself — connecting the integration is enough, and
# they'll appear in your project's env vars on their own. See README.md for
# the exact steps.
# -----------------------------------------------------------------------------

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
APP_BASE_URL=

# --- Push notifications (optional) ------------------------------------------
# Turns on real phone/tablet push alerts for new notifications — a cost
# impact reported, a request assigned to someone — even with Nucleus closed.
# No paid SMS/email service, and no npm dependency (same hand-built Web Push
# implementation as the Render build — see lib/webpush.js). Generate both
# together, once for this whole deployment, by running from this project's
# folder (needs Node, not Vercel — this doesn't run as part of a deploy):
#   node generate-vapid-keys.js
# and set both exactly as printed. The private key is as sensitive as
# NUCLEUS_ENCRYPTION_KEY — keep it out of anything you commit or share.
# Leave both unset to keep push notifications off; nothing else depends on them.
NUCLEUS_VAPID_PUBLIC_KEY=
NUCLEUS_VAPID_PRIVATE_KEY=
# -----------------------------------------------------------------------------
